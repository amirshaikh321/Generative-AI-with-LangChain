   "metadata": {},
   "outputs": [],
   "source": [
    "from langchain.tools import tool\n",
    "\n",
    "@tool \n",
    "def multiply(a:int, b:int ):\n",
    "    \"\"\"this is a tool of multiplication of two numbers\"\"\"\n",
    "    return a*b"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "4bea0801",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "396\n"
     ]
    }
   ],
   "source": [
    "tool = multiply\n",
    "\n",
    "result = tool.invoke({\"a\":12,\"b\":33})\n",
    "print(result)"
   ]
  },
